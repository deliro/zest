# Keep this listener local unless you intend to make it reachable on a network.
ZEST_BIND=127.0.0.1:8080

# Add DNS names used to reach the dashboard, separated by commas.
# ZEST_ALLOWED_HOSTS=monitor.example.test

# The systemd service requires memory locking by default.
ZEST_LOCK_MEMORY=1

# Uncomment to select a CPU temperature sensor explicitly.
# ZEST_TEMPERATURE_PATH=/sys/class/hwmon/hwmon0/temp1_input
